---
// Page-builder renderer. Maps each flexibleSections block (_type) to its
// on-brand component. Unknown types are skipped. Used by the generic `page`
// type at /[slug] and any page that adds a flexibleSections[] field.
//
// Shell-aware blocks (the newer, tone-adaptive ones) render their inner content
// only and are wrapped in <SectionShell> so a single editor control sets their
// background (token tone, or image/video with overlay). The original blocks
// render their own section background and are passed through unwrapped.
import SectionShell from '@/components/SectionShell.astro';
import RichTextBlock from '@/components/blocks/RichTextBlock.astro';
import ImageTextBlock from '@/components/blocks/ImageTextBlock.astro';
import CardGridBlock from '@/components/blocks/CardGridBlock.astro';
import QuoteBlock from '@/components/blocks/QuoteBlock.astro';
import CtaBandBlock from '@/components/blocks/CtaBandBlock.astro';
import FormRefBlock from '@/components/blocks/FormRefBlock.astro';
import FeatureCardsBlock from '@/components/blocks/FeatureCardsBlock.astro';
import StatsBlock from '@/components/blocks/StatsBlock.astro';
import AccordionBlock from '@/components/blocks/AccordionBlock.astro';
import GalleryBlock from '@/components/blocks/GalleryBlock.astro';
import StepsBlock from '@/components/blocks/StepsBlock.astro';
import LogosBlock from '@/components/blocks/LogosBlock.astro';
import MediaFeatureBlock from '@/components/blocks/MediaFeatureBlock.astro';
import DynamicListBlock from '@/components/blocks/DynamicListBlock.astro';
import ArchShowcaseBlock from '@/components/blocks/ArchShowcaseBlock.astro';
import FaqListBlock from '@/components/blocks/FaqListBlock.astro';
import EmbedBlock from '@/components/EmbedBlock.astro';
import { sectionEditAttr, sectionFieldEditAttr, type EditDoc } from '@/lib/preview-edit-attr';
import {
  BACKGROUND_FIELD,
  HEADING_ACCENT_FIELD,
  SURFACE_FIELD,
  hasAppearance,
  headingAccentApplies,
} from '@/lib/section-fields';

interface Props {
  sections?: any[] | null;
  /** Passed to form blocks for the keyless mailto fallback. */
  fallbackEmail?: string;
  /**
   * PREVIEW ONLY. When the Studio preview route passes the document each
   * section belongs to, every section is wrapped in a real block box carrying a
   * `data-sanity` attribute, which is what gives the Presentation overlay its
   * in-canvas insert / duplicate / remove / drag-to-reorder controls
   * (PORTS.md card 17).
   *
   * The live pages never pass it, and with it absent the wrapper is a
   * `<Fragment>`, which renders NOTHING at all. That is why the static build's
   * markup stays byte-identical with this feature installed, and
   * `npm run parity compare` is the standing gate on that promise.
   *
   * `editDoc.field` matters here: singletons keep their sections in
   * `flexibleSections`, the generic `page` type in `sections`. The preview
   * route picks the right one.
   */
  editDoc?: EditDoc;
}
const { sections = [], fallbackEmail, editDoc } = Astro.props;

// A real element in preview, nothing at all on the live site. The wrapper must
// NOT be `display: contents`: the overlay outlines the element's rect, and a
// contents element has none. A plain block-level div around a full-width
// <section> changes no layout.
const Wrap = editDoc ? 'div' : Fragment;
// `position: relative` in preview only, so the handles below can pin themselves
// to the section's own top-right corner. The wrapper's box IS the section's box,
// so this changes no layout and no live markup.
const wrapAttrs = (key: string | undefined) =>
  editDoc && key
    ? { 'data-sanity': sectionEditAttr(editDoc, key), style: 'position:relative' }
    : {};

// ---------------------------------------------------------------------------
// The in-canvas handles (PORTS.md card 28) - PREVIEW ONLY, same editDoc gate
// ---------------------------------------------------------------------------
// A floating card needs a node the Studio schema resolves to a FIELD. The
// wrapper above names a bare array item, which resolves to none, so a custom
// overlay component can never mount on it (see sectionFieldEditAttr). These
// little squares are those nodes: each points at a real field on the section, so
// clicking one selects that field and the overlay answers with its card.
//
// TOP-RIGHT, INSIDE the band. A section is usually taller than the viewport, so
// its bottom-right corner is below the fold exactly when the editor is looking
// at the section; its top-right is on screen the moment the band is. They render
// after the content so they paint above it, and they carry their styles inline
// because the preview loads no preview-only stylesheet.
//
// Each handle appears only where its control has something to do:
//   - the palette, for the fifteen types that carry `bgField()`. Not the form
//     section and not an embed, which have no background object at all;
//   - the accent word, for the five types that carry `headingAccent` AND only
//     when the heading actually holds words to offer.
const handleStyle = (right: string) =>
  `position:absolute;top:12px;right:${right};z-index:5;width:28px;height:28px;` +
  'border-radius:999px;background:#ffffff;border:1px solid rgba(31,27,22,0.18);' +
  'box-shadow:0 2px 8px rgba(22,50,44,0.24);display:flex;align-items:center;' +
  'justify-content:center;font-size:14px;line-height:1;';

const MAP: Record<string, any> = {
  sectionRichText: RichTextBlock,
  sectionImageText: ImageTextBlock,
  sectionCardGrid: CardGridBlock,
  sectionQuote: QuoteBlock,
  sectionCtaBand: CtaBandBlock,
  sectionForm: FormRefBlock,
  sectionFeatureCards: FeatureCardsBlock,
  sectionStats: StatsBlock,
  sectionAccordion: AccordionBlock,
  sectionGallery: GalleryBlock,
  sectionSteps: StepsBlock,
  sectionLogos: LogosBlock,
  sectionMediaFeature: MediaFeatureBlock,
  sectionDynamicList: DynamicListBlock,
  sectionArchShowcase: ArchShowcaseBlock,
  sectionFaqList: FaqListBlock,
  embed: EmbedBlock,
};

// Blocks that render inner content only and take their background from SectionShell.
const SHELL_AWARE = new Set([
  'sectionRichText', 'sectionImageText', 'sectionCardGrid', 'sectionQuote', 'sectionCtaBand',
  'sectionFeatureCards', 'sectionStats', 'sectionAccordion', 'sectionGallery',
  'sectionSteps', 'sectionLogos', 'sectionMediaFeature', 'sectionDynamicList',
  'sectionArchShowcase', 'sectionFaqList',
]);

// Default background tone when the editor hasn't chosen one (the quote + CTA
// bands were originally chapel green, so they keep that look by default).
const DEFAULT_TONE: Record<string, string> = {
  sectionQuote: 'chapel',
  sectionCtaBand: 'chapel',
};
---

{
  (sections ?? []).map((block: any) => {
    const Cmp = MAP[block?._type];
    if (!Cmp) return null;
    const inner = SHELL_AWARE.has(block._type) ? (
      (() => {
        const dt = DEFAULT_TONE[block._type] ?? 'default';
        return (
          <SectionShell background={block.background} defaultTone={dt}>
            <Cmp block={block} defaultTone={dt} fallbackEmail={fallbackEmail} />
          </SectionShell>
        );
      })()
    ) : (
      <Cmp block={block} fallbackEmail={fallbackEmail} />
    );
    const key = block?._key;
    const styleHandle =
      editDoc && key && hasAppearance(block._type)
        ? sectionFieldEditAttr(editDoc, key, `${BACKGROUND_FIELD}.${SURFACE_FIELD}`)
        : undefined;
    const accentHandle =
      editDoc && key && headingAccentApplies(block._type, block)
        ? sectionFieldEditAttr(editDoc, key, HEADING_ACCENT_FIELD)
        : undefined;
    return (
      <Wrap {...wrapAttrs(key)}>
        {inner}
        {styleHandle && (
          <div data-sanity={styleHandle} data-style-handle title="How this section looks" aria-hidden="true" style={handleStyle('12px')}>
            &#127912;
          </div>
        )}
        {accentHandle && (
          <div data-sanity={accentHandle} data-accent-handle title="Accent word" aria-hidden="true" style={`${handleStyle(styleHandle ? '48px' : '12px')}font-weight:800;color:#1E423B;`}>
            A
          </div>
        )}
      </Wrap>
    );
  })
}
